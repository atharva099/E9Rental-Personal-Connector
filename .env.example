# Reference template only: Spring and Start-Personal.ps1 do not automatically load this file.
# Replace path placeholders before using any value manually. Personal setup uses the
# Start-Personal.ps1 -PrivateDirectory and -ClientFile arguments instead.
# Never put real secrets into Git, frontend source, VITE_* variables or browser storage.
SERVER_PORT=8080
PRACTICE_TENANT_ID=practice-local
# Vite server-side proxy only; set in the frontend terminal. No token injection.
BACKEND_ORIGIN=http://127.0.0.1:8080

# Fail closed until an operator explicitly approves a dedicated synthetic/sandbox account.
# Never use a personal/company account; keep actual identifiers in an external local configuration.
GOOGLE_ACCESS_MODE=SANDBOX
SANDBOX_GOOGLE_APPROVED=false
SANDBOX_GMAIL_ACCOUNT=
# Exact Drive user.permissionId from the approved account; not its email or a guessed ID.
SANDBOX_DRIVE_ACCOUNT_ID=
# Actual approved folder ID (not the root alias); direct children only, no nested/shared/shortcut files.
SANDBOX_DRIVE_ROOT_FOLDER_ID=

# Optional personal-use profile. Disabled unless all flags are explicitly set by Start-Personal.ps1.
# Do not put actual identifiers or keys in this file. Personal runtime paths must be external and separate.
PERSONAL_GOOGLE_ENABLED=false
PERSONAL_GOOGLE_APPROVED=false
PERSONAL_DRIVE_ENABLED=false
PERSONAL_GMAIL_ACCOUNT=
# Required only when PERSONAL_DRIVE_ENABLED=true.
PERSONAL_DRIVE_ACCOUNT_ID=
PERSONAL_DRIVE_ROOT_FOLDER_ID=
PERSONAL_RUNTIME_DIR=
PERSONAL_TENANT_ID=
PERSONAL_TOKEN_ENCRYPTION_KEY=
PERSONAL_LOCAL_API_TOKEN=
PERSONAL_PATH_VALIDATION_PASSED=false
CHALLENGE_RUNTIME_DIR=REPLACE_WITH_ABSOLUTE_EXTERNAL_CHALLENGE_RUNTIME_PATH
CHALLENGE_TENANT_ID=practice-local

# SANDBOX/Challenge example: use an external Desktop client JSON via Start-Local.ps1 -ClientFile.
# Personal setup supplies its client path to Start-Personal.ps1; this template is not loaded by that launcher.
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/api/gmail/oauth/callback
DRIVE_REDIRECT_URI=http://127.0.0.1:8080/api/drive/oauth/callback
# Launch helpers generate persistent random keys externally. Do not use placeholders at runtime.
LOCAL_API_TOKEN=replace_with_random_token_at_least_32_characters
TOKEN_ENCRYPTION_KEY=replace_with_base64_of_32_random_bytes
# Replace each placeholder with a path inside your own external runtime, outside every checkout.
GMAIL_TOKEN_FILE=REPLACE_WITH_EXTERNAL_RUNTIME_PATH/gmail-token.enc
DRIVE_TOKEN_FILE=REPLACE_WITH_EXTERNAL_RUNTIME_PATH/drive-token.enc
GMAIL_OUTPUT_FILE=REPLACE_WITH_EXTERNAL_RUNTIME_PATH/outputs/gmail_output.json
DRIVE_OUTPUT_FILE=REPLACE_WITH_EXTERNAL_RUNTIME_PATH/outputs/drive_output.json
GMAIL_REFERENCE_DATE=
GMAIL_MAX_PAGES=100
GMAIL_REQUEST_DELAY_MS=200

# WhatsApp is SIMULATED only; empty selected_groups denies all.
WHATSAPP_MODE=SIMULATED
WHATSAPP_SELECTED_GROUPS=sim-group-rentals,sim-group-operations
WHATSAPP_SIMULATED_ACCOUNT=sim-account-local
WHATSAPP_STORE_URL=jdbc:h2:file:REPLACE_WITH_EXTERNAL_RUNTIME_PATH/whatsapp-simulated/messages;DB_CLOSE_ON_EXIT=FALSE
WHATSAPP_OUTPUT_FILE=REPLACE_WITH_EXTERNAL_RUNTIME_PATH/outputs/whatsapp_simulated_output.json
UNIFIED_STORE_URL=jdbc:h2:file:REPLACE_WITH_EXTERNAL_RUNTIME_PATH/unified/index;DB_CLOSE_ON_EXIT=FALSE

# FUTURE/UNUSED: no MySQL, Meta or external AI adapter is activated by these placeholders.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=e9rental_practice
MYSQL_USER=replace_me
MYSQL_PASSWORD=replace_me
WHATSAPP_VERIFY_TOKEN=replace_me
WHATSAPP_APP_SECRET=replace_me
WHATSAPP_ACCESS_TOKEN=replace_me
WHATSAPP_PHONE_NUMBER_ID=replace_me
AI_PROVIDER=replace_me
AI_MODEL=replace_me
AI_API_KEY=replace_me

# Bounded deterministic Q&A: empty reference uses current UTC; Gmail cutoff uses GMAIL_REFERENCE_DATE.
QA_REFERENCE_INSTANT=
# Explicit selected simulated group mapped to Site team; empty means no group resolution.
WHATSAPP_SITE_TEAM_GROUP=

# Set true only for an explicitly complete, reviewed sales snapshot; otherwise totals abstain.
QA_SALES_SNAPSHOT_COMPLETE=false

# Optional JSON file {"selected_groups":["sim-group-..."]}; when set it replaces the env allowlist, with no union or fallback.
# Example: config/whatsapp-simulated-groups.json (fabricated IDs only).
WHATSAPP_GROUP_CONFIG_FILE=
